{
  "name": "obsidian-journal-companion",
  "version": "0.4.0",
  "description": "A pen pal who reads your journal and writes back: a warm letter for every entry, plus weekly, monthly, and yearly look-backs.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc && node esbuild.config.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "journal",
    "llm",
    "claude"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
